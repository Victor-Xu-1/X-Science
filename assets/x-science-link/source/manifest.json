{
  "manifest_version": 3,
  "name": "X-Science Browser Connector",
  "description": "X-Science browser connection, local file authorization and local capabilities.",
  "version": "0.6.11",
  "minimum_chrome_version": "114",
  "homepage_url": "https://github.com/Victor-Xu-1/X-Science",
  "icons": {
    "16": "icons/x-science-mark.png",
    "32": "icons/x-science-mark.png",
    "48": "icons/x-science-mark.png",
    "128": "icons/x-science-mark.png"
  },
  "permissions": [
    "<all_urls>",
    "activeTab",
    "alarms",
    "downloads",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://115.190.116.251/*",
        "https://115.190.116.251/*",
        "http://115.190.116.251:*/*",
        "https://115.190.116.251:*/*",
        "http://127.0.0.1:*/*",
        "https://127.0.0.1:*/*",
        "http://localhost:*/*",
        "https://localhost:*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X-Science Browser Connector",
    "default_icon": {
      "16": "icons/x-science-mark.png",
      "32": "icons/x-science-mark.png"
    }
  },
  "options_page": "options.html"
}
