#!/usr/bin/env bash
# The host owns selection; this helper only observes and packages exact paths.
# Each data operation survives control-channel loss and publishes atomically.
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C
unset TAR_OPTIONS GZIP BASH_ENV ENV CDPATH
cd -- "$(dirname -- "$0")"
root=$PWD
control=.synon-harvest
[[ ! -L $control ]] || exit 76
mkdir -p -- "$control"
chmod 700 -- "$control"
[[ ! -L $control/lock && ( ! -e $control/lock || -f $control/lock ) ]] || exit 76
self=$root/$(basename -- "$0")

receipt() {
  local slot=$1 state digest size extra
  [[ -f $slot && ! -L $slot ]] || exit 76
  IFS=: read -r state digest size extra < "$slot" || exit 76
  if [[ $state == ready && $digest =~ ^[0-9a-f]{64}$ && $size =~ ^[0-9]{1,20}$ && -z $extra ]]; then
    printf 'ready:%s:%s\n' "$digest" "$size"
  elif [[ $state == failed && $digest =~ ^[0-9]{1,3}$ && -z $size && -z $extra ]]; then
    printf 'failed:%s\n' "$digest"
  else
    exit 76
  fi
}

identity() {
  local pid=$1 stat tail
  [[ $pid =~ ^[1-9][0-9]*$ ]] && [[ -r /proc/$pid/stat ]] || return 1
  stat=$(<"/proc/$pid/stat")
  tail=${stat##*) }
  local fields=()
  read -r -a fields <<< "$tail"
  [[ ${#fields[@]} -ge 20 && ${fields[0]} != Z && ${fields[0]} != X ]] || return 1
  printf '%s:%s:%s' "$(</proc/sys/kernel/random/boot_id)" "$pid" "${fields[19]}"
}

alive() {
  local owner=$1 boot pid ticks nonce current
  [[ -f $owner && ! -L $owner ]] || return 1
  IFS=: read -r boot pid ticks nonce < "$owner" || return 1
  current=$(identity "$pid") || return 1
  [[ $current == "$boot:$pid:$ticks" ]]
}

owned() {
  local recorded nonce
  [[ -f $owner && ! -L $owner ]] || return 1
  recorded=$(<"$owner")
  nonce=${recorded##*:}
  [[ $nonce == "${temporary##*/}" && $recorded == "$(identity "$$"):$nonce" ]]
}

worker_exit() {
  local result=$1
  if [[ $result -ne 0 ]] && owned; then
    printf 'failed:%s\n' "$result" > "$temporary/failure"
    mv -fT -- "$temporary/failure" "$control/$name.failure"
  fi
}

publish() {
  local payload=$1 destination=$2 digest size
  digest=$(sha256sum -- "$payload"); digest=${digest%% *}
  size=$(stat -c %s -- "$payload")
  exec 9>>"$control/lock"
  flock -x 9
  owned || exit 75
  mv -fT -- "$payload" "$destination"
  printf 'ready:%s:%s\n' "$digest" "$size" > "$temporary/receipt"
  mv -fT -- "$temporary/receipt" "$control/$name.receipt"
}

start() {
  local operation=$1
  shift
  local current pid
  if [[ -e $control/$name.receipt || -L $control/$name.receipt ]]; then receipt "$control/$name.receipt"; return; fi
  if alive "$control/$name.owner"; then printf 'working\n'; return; fi
  if [[ -e $control/$name.failure || -L $control/$name.failure ]]; then receipt "$control/$name.failure"; return; fi
  exec 9>>"$control/lock"
  flock -x 9
  if [[ -e $control/$name.receipt || -L $control/$name.receipt ]]; then receipt "$control/$name.receipt"; return; fi
  if alive "$control/$name.owner"; then printf 'working\n'; return; fi
  temporary=$(mktemp -d "$control/$name.XXXXXXXX")
  ( exec 9>&-; exec setsid bash --noprofile --norc -p "$self" "$operation" "$name" "$temporary" "$@" ) \
    </dev/null >"$temporary/worker.log" 2>&1 &
  pid=$!
  current=$(identity "$pid") || {
    [[ -f $control/$name.receipt ]] && receipt "$control/$name.receipt" && return
    printf 'unknown\n'; return
  }
  printf '%s:%s\n' "$current" "${temporary##*/}" > "$temporary/owner"
  mv -fT -- "$temporary/owner" "$control/$name.owner"
  printf 'working\n'
}

case ${1:-} in
  check)
    for tool in bash find tar gzip sha256sum stat flock setsid mktemp mv cp chmod head; do command -v "$tool" >/dev/null || exit 78; done
    find --version >/dev/null 2>&1 && tar --version >/dev/null 2>&1 || exit 78
    [[ -r /proc/sys/kernel/random/boot_id ]] || exit 78
    ;;
  inventory)
    name=inventory
    start _inventory
    ;;
  archive)
    source_sha=${2:-}; selection_sha=${3:-}
    [[ $source_sha =~ ^[0-9a-f]{64}$ && $selection_sha =~ ^[0-9a-f]{64}$ ]] || exit 76
    [[ -f $control/inventory.receipt && ! -L $control/inventory.receipt ]] || exit 75
    IFS=: read -r ready observed bytes < "$control/inventory.receipt"
    [[ $ready == ready && $observed == "$source_sha" ]] || exit 75
    selection=$control/selection-$selection_sha.nul
    [[ -f $selection && ! -L $selection ]] || exit 76
    actual=$(sha256sum -- "$selection"); actual=${actual%% *}
    [[ $actual == "$selection_sha" ]] || exit 76
    name=archive-$source_sha-$selection_sha
    start _archive "$source_sha" "$selection_sha"
    ;;
  checkpoint)
    manifest=${2:-}; manifest_key=${3:-}
    [[ $manifest == out/* && $manifest_key =~ ^[0-9a-f]{64}$ ]] || exit 76
    actual=$(printf %s "$manifest" | sha256sum); actual=${actual%% *}
    [[ $actual == "$manifest_key" ]] || exit 76
    name=checkpoint-$manifest_key
    start _checkpoint "$manifest"
    ;;
  prefix)
    file=${2:-}; limit=${3:-}; content_sha=${4:-}
    [[ $file =~ ^(inventory\.nul|checkpoint-[0-9a-f]{64}\.jsonl|archive-[0-9a-f]{64}-[0-9a-f]{64}\.tar\.gz)$ && $limit =~ ^[0-9]{1,19}$ && $content_sha =~ ^[0-9a-f]{64}$ ]] || exit 76
    name=prefix-$content_sha-$limit
    start _prefix "$file" "$limit" "$content_sha"
    ;;
  _inventory|_archive|_checkpoint|_prefix)
    operation=$1; name=${2:-}; temporary=${3:-}
    [[ $name == inventory || $name =~ ^archive-[0-9a-f]{64}-[0-9a-f]{64}$ || $name =~ ^checkpoint-[0-9a-f]{64}$ || $name =~ ^prefix-[0-9a-f]{64}-[0-9]{1,19}$ ]] || exit 76
    [[ $temporary =~ ^\.synon-harvest/(inventory|archive-[0-9a-f]{64}-[0-9a-f]{64}|checkpoint-[0-9a-f]{64}|prefix-[0-9a-f]{64}-[0-9]{1,19})\.[A-Za-z0-9]{8}$ ]] || exit 76
    [[ $temporary == "$control/$name".* && -d $temporary && ! -L $temporary ]] || exit 76
    [[ $operation != _inventory || $name == inventory ]] || exit 76
    owner=$control/$name.owner
    exec 9>>"$control/lock"
    flock -x 9
    owned || exit 75
    flock -u 9; exec 9>&-
    trap 'worker_exit "$?"' EXIT
    if [[ $operation == _inventory ]]; then
      roots=(stdout.log stderr.log)
      if [[ -e out || -L out ]]; then roots+=(out); fi
      find "${roots[@]}" -printf '%y\0%p\0%s\0%T@\0' > "$temporary/inventory.nul"
      publish "$temporary/inventory.nul" "$control/inventory.nul"
    elif [[ $operation == _prefix ]]; then
      file=${4:-}; limit=${5:-}; content_sha=${6:-}
      [[ $file =~ ^(inventory\.nul|checkpoint-[0-9a-f]{64}\.jsonl|archive-[0-9a-f]{64}-[0-9a-f]{64}\.tar\.gz)$ && $limit =~ ^[0-9]{1,19}$ && $content_sha =~ ^[0-9a-f]{64}$ && $name == prefix-$content_sha-$limit ]] || exit 76
      [[ -f $control/$file && ! -L $control/$file ]] || exit 76
      bytes=$(stat -c %s -- "$control/$file"); [[ $bytes -ge $limit ]] || exit 76
      head -c "$limit" -- "$control/$file" | sha256sum > "$temporary/checksum"
      read -r digest _ < "$temporary/checksum"
      [[ $digest =~ ^[0-9a-f]{64}$ ]] || exit 76
      exec 9>>"$control/lock"; flock -x 9; owned || exit 75
      printf 'ready:%s:%s\n' "$digest" "$limit" > "$temporary/receipt"
      mv -fT -- "$temporary/receipt" "$control/$name.receipt"
    elif [[ $operation == _checkpoint ]]; then
      manifest=${4:-}
      [[ $manifest == out/* && $manifest != *'/../'* && $manifest != */.. && $manifest != *'/./'* && $manifest != *'//'* && -f $manifest && ! -L $manifest ]] || exit 76
      actual=$(printf %s "$manifest" | sha256sum); actual=${actual%% *}
      [[ $name == checkpoint-$actual ]] || exit 76
      ancestor=$manifest
      while [[ $ancestor == */* ]]; do ancestor=${ancestor%/*}; [[ ! -L $ancestor ]] || exit 76; done
      cp -- "$manifest" "$temporary/checkpoint.jsonl"
      publish "$temporary/checkpoint.jsonl" "$control/$name.jsonl"
    else
      source_sha=${4:-}; selection_sha=${5:-}
      [[ $source_sha =~ ^[0-9a-f]{64}$ && $selection_sha =~ ^[0-9a-f]{64}$ ]] || exit 76
      selection=$control/selection-$selection_sha.nul
      while IFS= read -r -d '' item; do
        [[ $item == stdout.log || $item == stderr.log || $item == out/* ]] || exit 76
        [[ $item != *'/../'* && $item != *'/./'* && $item != *'//'* && $item != */.. ]] || exit 76
        [[ -f $item && ! -L $item ]] || exit 76
        ancestor=$item
        while [[ $ancestor == */* ]]; do
          ancestor=${ancestor%/*}
          [[ ! -L $ancestor ]] || exit 76
        done
      done < "$selection"
      env -u TAR_OPTIONS -u GZIP tar --create --gzip --blocking-factor=1 --file "$temporary/output.tar.gz" \
        --null --verbatim-files-from --no-recursion --hard-dereference --files-from "$selection"
      publish "$temporary/output.tar.gz" "$control/$name.tar.gz"
    fi
    ;;
  *) exit 76 ;;
esac
