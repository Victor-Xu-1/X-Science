{
  "schema": "x-science.runtime-input-scope.v1",
  "groups": [
    {
      "name": "canonical-agent-policy-inputs",
      "paths": ["assets/x_science_system_prompt.txt", "internal/agentruntime/assets/x_science_platform_policy.md"],
      "packages": ["x-science/internal/assets", "x-science/internal/agentruntime"]
    },
    {
      "name": "native-ketcher-and-local-rna",
      "paths": ["assets/optional/mcp-servers/ketcher-chemistry.manifest.json", "assets/optional/mcp-servers/rna-design/run_server.py"],
      "packages": ["x-science/internal/assets", "x-science/internal/ketchermcp", "x-science/internal/mcpdirectory", "x-science/internal/tools/mcpstdio"]
    },
    {
      "name": "provider-provenance-explanation",
      "paths": ["internal/logoassets/SOURCE.md"],
      "packages": ["x-science/internal/assets"]
    },
    {
      "name": "model-skill-product-prose",
      "manifests": [
        {"path": "assets/x-science/skills.manifest.json", "root": "skills/x-science", "kind": "asset"}
      ],
      "paths": [
        "assets/x-science/skills.manifest.json",
        "skills/x-science/ngs-analysis-router/SKILL.md",
        "skills/x-science/nextflow-development/references/geo-sra-acquisition.md",
        "skills/x-science/skill-creator/scripts/quick_validate.py",
        "skills/x-science/autodock-vina/scripts/autodock_vina.py",
        "skills/x-science/autodock-vina/scripts/autodock_vina_outputs.py"
      ],
      "packages": ["x-science/internal/assets", "x-science/internal/skills", "x-science/internal/sciencecapability", "x-science/internal/server"]
    },
    {
      "name": "bundled-agent-catalog",
      "paths": ["assets/x-science/agents.manifest.json"],
      "manifests": [
        {"path": "assets/x-science/agents.manifest.json", "root": "assets/x-science/agents", "kind": "asset"}
      ],
      "packages": ["x-science/internal/assets", "x-science/internal/agentruntime", "x-science/internal/server"]
    },
    {
      "name": "browser-connector-assets",
      "paths": [
        "assets/x-science-link/manifest.json",
        "assets/x-science-link/x-science-browser-extension-v0.6.11.zip"
      ],
      "packages": ["x-science/internal/assets", "x-science/internal/server", "x-science/cmd/x-science"]
    },
    {
      "name": "kernel-host-and-provider-display",
      "paths": [
        "assets/optional/kernels/x_science_host_bridge.py",
        "assets/optional/compute/provider_kernel_bootstrap.py",
        "assets/optional/compute/wrapper.sh.tmpl",
        "assets/optional/compute/operon_compute_provider/__init__.py"
      ],
      "packages": ["x-science/internal/assets", "x-science/internal/kernel", "x-science/internal/server", "x-science/internal/compute"]
    },
    {
      "name": "bundled-mcp-display",
      "manifests": [
        {"path": "assets/optional/mcp-servers/bio-tools.manifest.json", "root": "assets/optional/mcp-servers/bio-tools", "kind": "asset"}
      ],
      "paths": [
        "assets/optional/mcp-servers/bio-tools.manifest.json",
        "assets/optional/mcp-servers/bio-tools/run_server.py",
        "assets/optional/mcp-servers/bio-tools/lib/mcp_servers_common/tls_policy.py",
        "assets/optional/mcp-servers/bio-tools/lib/mcp_servers_common/ua.py"
      ],
      "packages": ["x-science/internal/assets", "x-science/internal/mcpdirectory", "x-science/internal/tools/mcpstdio", "x-science/internal/server"]
    },
    {
      "name": "kernel-worker-assets",
      "manifests": [
        {"path": "assets/optional/kernel-compute.manifest.json", "root": "assets/optional", "kind": "asset"}
      ],
      "paths": [
        "assets/optional/kernel-compute.manifest.json",
        "assets/optional/kernels/x_science_runtime/worker_execution.py",
        "assets/optional/kernels/x_science_runtime/worker_effects.py",
        "assets/optional/kernels/x_science_runtime/worker_streams.py",
        "assets/optional/kernels/x_science_runtime/worker_reads.py"
      ],
      "packages": [
        "x-science/internal/assets",
        "x-science/internal/kernel",
        "x-science/internal/compat/v11reuse"
      ]
    },
    {
      "name": "locked-runtime-catalogs",
      "paths": ["assets/optional/conda-runtimes/manifest.json"],
      "manifests": [
        {"path": "assets/optional/conda-runtimes/manifest.json", "root": "assets/optional/conda-runtimes", "kind": "conda-catalog"},
        {"path": "assets/optional/conda-runtimes/windows-x86_64/manifest.json", "root": "assets/optional/conda-runtimes/windows-x86_64", "kind": "conda-catalog"},
        {"path": "assets/optional/conda-runtimes/darwin-x86_64/manifest.json", "root": "assets/optional/conda-runtimes/darwin-x86_64", "kind": "conda-catalog"},
        {"path": "assets/optional/conda-runtimes/darwin-arm64/manifest.json", "root": "assets/optional/conda-runtimes/darwin-arm64", "kind": "conda-catalog"}
      ],
      "packages": ["x-science/internal/assets", "x-science/internal/kernel"]
    },
    {
      "name": "managed-installer-assets",
      "paths": [
        "assets/optional/micromamba/BUILD.md",
        "assets/optional/micromamba/DEPENDENCY-NOTICES.txt",
        "assets/optional/micromamba/build-linux-64.lock",
        "assets/optional/micromamba/build-linux-64.sh",
        "assets/optional/micromamba/collect-build-notices.py",
        "assets/optional/micromamba/link-script-exit.patch",
        "assets/optional/micromamba/linux-x86_64/micromamba",
        "assets/optional/micromamba/windows-x86_64/micromamba.exe",
        "assets/optional/micromamba/windows-x86_64/manifest.json",
        "assets/optional/micromamba/darwin-x86_64/micromamba",
        "assets/optional/micromamba/darwin-x86_64/manifest.json",
        "assets/optional/micromamba/darwin-arm64/micromamba",
        "assets/optional/micromamba/darwin-arm64/manifest.json",
        "assets/optional/micromamba/manifest.json"
      ],
      "packages": [
        "x-science/internal/assets",
        "x-science/internal/kernel",
        "x-science/internal/compat/v11reuse"
      ]
    }
  ]
}
