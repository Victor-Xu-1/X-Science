{
  "schema": "synon.verification-scope.v1",
  "groups": [
    {
      "name": "startup-smoke-tool-display",
      "paths": ["scripts/quality/startup_smoke_gate.py", "scripts/quality/test_startup_smoke_gate.py"],
      "frontend": false,
      "checks": [["python3", "-B", "scripts/quality/test_startup_smoke_gate.py"]]
    },
    {
      "name": "websearch-display",
      "paths": ["scripts/optional/websearch.py"],
      "packages": ["synon-go/internal/tools/websearch"],
      "frontend": false,
      "checks": [["python3", "-B", "scripts/optional/websearch.py", "--help"]]
    },
    {
      "name": "external-acceptance-cli-display",
      "paths": ["scripts/p9_external_acceptance.py", "scripts/p9_external_acceptance_test.py"],
      "frontend": false,
      "checks": [["python3", "-B", "-m", "unittest", "scripts.p9_external_acceptance_test"]]
    },
    {
      "name": "browser-connector-packaging",
      "paths": [
        "docs/non-web-asset-boundary.json",
        "scripts/packaging/browser_extension_branding.py",
        "scripts/packaging/build_browser_extension.py",
        "scripts/packaging/test_browser_extension_branding.py",
        "scripts/audit/audit-non-web-boundary.sh"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "scripts.packaging.build_browser_extension", "--repo", ".", "--check", "--fetch-source"],
        ["python3", "-B", "-m", "unittest", "scripts.packaging.test_browser_extension_branding"],
        ["bash", "scripts/audit/audit-non-web-boundary.sh"]
      ]
    },
    {
      "name": "example-config-display",
      "paths": [".env.example"],
      "packages": ["synon-go/internal/config"],
      "frontend": false,
      "checks": [["python3", "-B", "-m", "unittest", "scripts.quality.test_product_identity_gate"]]
    },
    {
      "name": "http-smoke-contract",
      "paths": ["scripts/smoke-http.sh"],
      "packages": ["synon-go/cmd/synon", "synon-go/internal/server", "synon-go/internal/config"],
      "frontend": false,
      "checks": [["bash", "-n", "scripts/smoke-http.sh"]]
    },
    {
      "name": "current-launcher-and-installer-display",
      "paths": [
        "scripts/dev/synon",
        "scripts/dev/install-source-cli.sh",
        "scripts/dev/source-cli-test.sh",
        "scripts/backup-release.sh",
        "scripts/rollback-release.sh",
        "scripts/uninstall-release.sh",
        "scripts/install-release.sh",
        "scripts/install-systemd-user.sh",
        "scripts/uninstall-systemd-user.sh",
        "scripts/install-release.ps1",
        "scripts/manage-release.ps1",
        "scripts/release-path-policy.sh",
        "scripts/release-identity-policy-test.sh",
        "scripts/goal-run.sh"
      ],
      "frontend": false,
      "checks": [
        ["bash", "scripts/dev/source-cli-test.sh"],
        ["bash", "scripts/release-identity-policy-test.sh"],
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_product_identity_gate"],
        ["bash", "-n", "scripts/backup-release.sh"],
        ["bash", "-n", "scripts/rollback-release.sh"],
        ["bash", "-n", "scripts/uninstall-release.sh"],
        ["bash", "-n", "scripts/install-release.sh"],
        ["bash", "-n", "scripts/install-systemd-user.sh"],
        ["bash", "-n", "scripts/uninstall-systemd-user.sh"],
        ["bash", "-n", "scripts/goal-run.sh"]
      ]
    },
    {
      "name": "source-backend-watcher",
      "paths": [
        "scripts/dev/source-backend-watch.sh",
        "scripts/dev/source-backend-watch-test.sh"
      ],
      "frontend": false,
      "packages": [
        "synon-go/cmd/synon",
        "synon-go/internal/config"
      ],
      "checks": [
        ["bash", "scripts/dev/source-backend-watch-test.sh"]
      ]
    },
    {
      "name": "frontend-related-selection",
      "paths": [
        "scripts/quality/pr_frontend_scope.py",
        "scripts/quality/test_pr_frontend_scope.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_pr_frontend_scope"]
      ]
    },
    {
      "name": "frontend-license-notices",
      "paths": [
        "docs/licenses/frontend-bundle/NOTICE.txt",
        "scripts/audit/frontend-license-report-test.py"
      ],
      "frontend": true,
      "checks": [
        ["python3", "-B", "scripts/audit/frontend-license-report-test.py"]
      ]
    },
    {
      "name": "source-hygiene",
      "paths": [
        "scripts/audit/audit-source-clean.sh",
        "scripts/audit/audit-source-clean-test.sh",
        "scripts/quality/repository_governance.py",
        "scripts/quality/test_repository_governance.py",
        "docs/governance/repository-maintenance.md",
        ".github/ISSUE_TEMPLATE/bug_report.yml",
        ".github/ISSUE_TEMPLATE/feature_request.yml",
        ".github/ISSUE_TEMPLATE/config.yml"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_repository_governance"],
        ["python3", "-B", "scripts/quality/repository_governance.py"],
        ["bash", "scripts/audit/audit-source-clean-test.sh"],
        ["bash", "scripts/audit/audit-source-clean.sh"]
      ]
    },
    {
      "name": "release-package",
      "paths": [
        ".github/workflows/packages.yml",
        "scripts/packaging/release_package.py",
        "scripts/packaging/oci_bundle.py",
        "scripts/packaging/test_release_package.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.packaging.test_release_package"]
      ]
    },
    {
      "name": "pr-version-counter",
      "paths": [
        "docs/governance/versioning.md",
        "scripts/quality/product_version.py",
        "scripts/packaging/test_product_version.py",
        "scripts/packaging/pr_version_gate.py",
        "scripts/packaging/test_pr_version_gate.py",
        "scripts/packaging/prepare_pr_version.py",
        "scripts/packaging/test_prepare_pr_version.py",
        "scripts/packaging/test_version_config.py",
        "scripts/packaging/version_provenance.py",
        "scripts/packaging/test_version_provenance.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.packaging.test_product_version", "scripts.packaging.test_pr_version_gate", "scripts.packaging.test_prepare_pr_version", "scripts.packaging.test_version_config", "scripts.packaging.test_version_provenance"]
      ]
    },
    {
      "name": "frontend-provenance",
      "paths": [
        "scripts/audit/audit_frontend_migration.py",
        "scripts/audit/audit_frontend_migration_test.py",
        "scripts/audit/audit-frontend-migration-test.py"
      ],
      "frontend": true,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.audit.audit_frontend_migration_test"],
        ["python3", "-B", "scripts/audit/audit-frontend-migration-test.py"]
      ]
    },
    {
      "name": "verification-selection",
      "paths": [
        "scripts/quality/README.md",
        "scripts/quality/verification_scope.json",
        "scripts/quality/verification_scope.py",
        "scripts/quality/test_verification_scope.py",
        "scripts/quality/pr_fast_scope.py",
        "scripts/quality/test_pr_fast_scope.py",
        "scripts/quality/pr_metadata_scope.py",
        "scripts/quality/test_pr_metadata_scope.py",
        "scripts/quality/pr_build_scope.py",
        "scripts/quality/test_pr_build_scope.py",
        "scripts/quality/pr_dependency_scope.py",
        "scripts/quality/test_pr_dependency_scope.py",
        "scripts/quality/pr_test_partition.py",
        "scripts/quality/test_pr_test_partition.py",
        "scripts/quality/runtime_input_scope.py",
        "scripts/quality/runtime_input_scope.json",
        "scripts/quality/test_runtime_input_scope.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_pr_fast_scope", "scripts.quality.test_pr_metadata_scope", "scripts.quality.test_pr_build_scope", "scripts.quality.test_pr_dependency_scope", "scripts.quality.test_pr_test_partition", "scripts.quality.test_verification_scope", "scripts.quality.test_runtime_input_scope"]
      ]
    },
    {
      "name": "schema-and-package-contracts",
      "paths": [
        "docs/governance/product-identity.json",
        "docs/governance/product-identity-consumer-matrix.json",
        "docs/governance/product-rename-compatibility-map.json",
        "scripts/quality/test_product_identity_gate.py",
        "scripts/package-release-test.sh"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_product_identity_gate"],
        ["bash", "-n", "scripts/package-release-test.sh"]
      ]
    },
    {
      "name": "kernel-worker-protocol",
      "paths": [
        "scripts/quality/test_kernel_worker_streams.py",
        "scripts/quality/test_kernel_worker_protocol.py",
        "scripts/quality/test_kernel_worker_effects.py",
        "scripts/quality/kernel_manifest.py",
        "scripts/quality/test_kernel_manifest.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_kernel_worker_streams", "scripts.quality.test_kernel_worker_protocol", "scripts.quality.test_kernel_worker_effects"],
        ["python3", "-B", "scripts/quality/test_kernel_manifest.py"],
        ["python3", "-B", "scripts/quality/kernel_manifest.py"]
      ]
    },
    {
      "name": "workflow-contracts",
      "paths": [
        ".github/workflows/quality-pr.yml",
        ".github/workflows/quality-main.yml",
        ".github/workflows/quality.yml",
        "docs/governance/github-actions-pins.json",
        "scripts/ci-contract-test.sh"
      ],
      "frontend": false,
      "checks": [["bash", "scripts/ci-contract-test.sh"]]
    }
  ]
}
