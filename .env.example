# X-Science safe local defaults.
# Copy this file to .env, fill only the integrations you use, then load it with:
#   set -a; source .env; set +a

# Core runtime. Loopback is the safe default. A non-loopback X_SCIENCE_ADDRESS is
# rejected unless password authentication is configured, or an external web
# identity provider is configured together with an exact HTTPS public origin.
X_SCIENCE_ADDRESS=127.0.0.1:8765
X_SCIENCE_HOME=
X_SCIENCE_CONFIG=
X_SCIENCE_DATA_DIR_CONTROL=
X_SCIENCE_WORKING_DIR=
X_SCIENCE_CONDA_HOME=
X_SCIENCE_CONDA_ENVS_PATH=
X_SCIENCE_NETWORK_ALLOWED_DOMAINS=
X_SCIENCE_NETWORK_DENIED_DOMAINS=
X_SCIENCE_NETWORK_PROXY=
# Explicit network phase budgets, in seconds. None is a full-file transfer
# wall-clock limit. Progressing downloads retain their checkpoint and continue.
X_SCIENCE_NETWORK_RESPONSE_HEADER_TIMEOUT_SECONDS=60
X_SCIENCE_NETWORK_READ_IDLE_TIMEOUT_SECONDS=30
X_SCIENCE_NETWORK_TRANSFER_IDLE_TIMEOUT_SECONDS=300
X_SCIENCE_NETWORK_SEARCH_TIMEOUT_SECONDS=90
X_SCIENCE_NETWORK_CA_BUNDLE=
# auto (default), strict, or relaxed. An unrecognized value fails closed by
# falling through to the configured/automatic posture.
X_SCIENCE_MCP_X509_STRICT=auto
X_SCIENCE_PLUGIN_DIRS=
X_SCIENCE_SKILL_DIRS=

# Agent runner. Workspace mode requires an enabled active saved model provider.
X_SCIENCE_RUNNER_ENABLED=true
X_SCIENCE_RUNNER_ID=x-science-runner
X_SCIENCE_RUNNER_PROVIDER=workspace
X_SCIENCE_RUNNER_COMMAND=
X_SCIENCE_RUNNER_ARGS_JSON=[]
X_SCIENCE_RUNNER_CHAT_ENDPOINT=
X_SCIENCE_RUNNER_CHAT_API_KEY=
X_SCIENCE_RUNNER_CHAT_MODEL=
X_SCIENCE_RUNNER_CHAT_SYSTEM_PROMPT=
X_SCIENCE_RUNNER_CHAT_TOOLS=
X_SCIENCE_RUNNER_CHAT_TIMEOUT_SECONDS=120
X_SCIENCE_RUNNER_CHAT_TOOL_ROUND_LIMIT=64
X_SCIENCE_RUNNER_CHAT_MAX_ATTEMPTS=4
X_SCIENCE_RUNNER_COMMAND_TIMEOUT_SECONDS=600
X_SCIENCE_RUNNER_POLL_INTERVAL_MS=1000
X_SCIENCE_RUNNER_LEASE_TTL_SECONDS=300
X_SCIENCE_RUNNER_REPLAY_LIMIT=200
X_SCIENCE_RUNNER_OUTPUT_LIMIT_BYTES=1048576

# Optional compact summarizer
X_SCIENCE_COMPACT_SUMMARIZER_ENDPOINT=
X_SCIENCE_COMPACT_SUMMARIZER_API_KEY=
X_SCIENCE_COMPACT_SUMMARIZER_MODEL=
X_SCIENCE_COMPACT_SUMMARIZER_TIMEOUT_SECONDS=120
X_SCIENCE_COMPACT_SUMMARIZER_MAX_ATTEMPTS=2

# Shared X-Science Web and browser-bridge authentication. Leave both credentials blank only
# for a trusted loopback-only development runtime. Web and Link sessions use
# separate scopes even though they share these configured operator credentials.
X_SCIENCE_LINK_AUTH_USERNAME=
X_SCIENCE_LINK_AUTH_PASSWORD=
X_SCIENCE_LINK_AUTH_SESSION_TTL_MINUTES=2880
# Optional external web sign-in. Provider callbacks are handled server-side;
# provider tokens are validated there and are never persisted in frontend
# storage. Leave the public origin blank for a loopback-only deployment.
X_SCIENCE_AUTH_PUBLIC_BASE_URL=
X_SCIENCE_AUTH_GOOGLE_CLIENT_ID=
X_SCIENCE_AUTH_GOOGLE_CLIENT_SECRET=
# Sign in with Apple requires a Services ID, Team ID, Key ID, and private key.
# Supply the key by absolute file path or Base64; raw multiline environment
# values are intentionally rejected. The callback is:
#   ${X_SCIENCE_AUTH_PUBLIC_BASE_URL}/api/auth/oidc/apple/callback
X_SCIENCE_AUTH_APPLE_CLIENT_ID=
X_SCIENCE_AUTH_APPLE_TEAM_ID=
X_SCIENCE_AUTH_APPLE_KEY_ID=
X_SCIENCE_AUTH_APPLE_PRIVATE_KEY_FILE=
X_SCIENCE_AUTH_APPLE_PRIVATE_KEY_B64=
# WeChat Open Platform website-app login is separate from the message-channel
# WECHAT_* credentials below. The callback is:
#   ${X_SCIENCE_AUTH_PUBLIC_BASE_URL}/api/auth/oauth/wechat/callback
X_SCIENCE_AUTH_WECHAT_APP_ID=
X_SCIENCE_AUTH_WECHAT_APP_SECRET=
X_SCIENCE_LINK_SERVER_URL=http://127.0.0.1:8765
X_SCIENCE_LINK_USER_ID=
X_SCIENCE_DESKTOP_FILE_OPEN_ARGS_JSON=[]

# Message channels. Keep credentials blank for unused channels.
X_SCIENCE_ENABLED_ADAPTERS=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_ACCESS_TOKEN=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DOMAIN=
WECHAT_ACCOUNT_ID=
WECHAT_BOT_TOKEN=
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_USER_ID=
WECHAT_POLL_INTERVAL_MS=1000

# Live message delivery verification targets
WECHAT_LIVE_SMOKE_USER_ID=
FEISHU_LIVE_SMOKE_CHAT_ID=
FEISHU_LIVE_SMOKE_OPEN_ID=
X_SCIENCE_LIVE_IM_RUNTIME_URL=http://127.0.0.1:8765
X_SCIENCE_LIVE_IM_REQUIRE_ALL=false
X_SCIENCE_LIVE_IM_SMOKE_MESSAGE=
X_SCIENCE_LIVE_IM_SMOKE_TIMEOUT_SECONDS=30

# Optional protocol integrations
X_SCIENCE_MCP_CONFIG=
X_SCIENCE_MCP_CONFIG_JSON=
X_SCIENCE_MCP_TIMEOUT_SECONDS=120
X_SCIENCE_MCP_SDK_BRIDGE_COMMAND=
X_SCIENCE_MCP_SDK_BRIDGE_ARGS_JSON=[]
X_SCIENCE_LSP_CONFIG=
X_SCIENCE_LSP_CONFIG_JSON=
X_SCIENCE_LSP_TIMEOUT_SECONDS=30
X_SCIENCE_WEBSEARCH_MODE=
X_SCIENCE_WEBSEARCH_ENDPOINT=
X_SCIENCE_WEBSEARCH_GO=true
# Optional source-only fallback. It is used only when explicitly configured.
# Example: /absolute/source/scripts/optional/websearch.py
X_SCIENCE_WEBSEARCH_SCRIPT=
X_SCIENCE_WEBSEARCH_PYTHON=

# Optional compute integrations
X_SCIENCE_KERNEL_PYTHON=
X_SCIENCE_KERNEL_ASSET_ROOT=
X_SCIENCE_MODAL_CONFIG_PATH=
X_SCIENCE_MODAL_RUNTIME_PYTHON=
X_SCIENCE_MODAL_RUNTIME_SCRIPT=
X_SCIENCE_MODAL_PROVIDER_PATH=
X_SCIENCE_MODAL_LIFECYCLE_PYTHON=
X_SCIENCE_MODAL_LIFECYCLE_SCRIPT=
# Feedback and telemetry
OPERON_SERVICE_URL=
X_SCIENCE_FEEDBACK_TOKEN=
X_SCIENCE_FEEDBACK_BETA=
X_SCIENCE_FEEDBACK_DISABLED=false
X_SCIENCE_DISABLE_TELEMETRY=false
X_SCIENCE_TUI_BASE_URL=http://127.0.0.1:8765
X_SCIENCE_TUI_HISTORY=
X_SCIENCE_TUI_RUNNER_ID=x-science-runner
X_SCIENCE_TUI_EDITOR=
# Optional explicit static Web asset directory. A packaged install discovers
# the adjacent web/ directory automatically.
X_SCIENCE_WEB_ROOT=
